# DECARGO · plantilla de configuración. `./deca init` genera un .env real con secretos aleatorios.
# Nunca subas .env a un repositorio ni lo compartas: contiene todas las credenciales.

DECARGO_VERSION=0.1.0-bloque1

# --- PostgreSQL (el superusuario solo lo usan `migrate` y la restauración) ---
POSTGRES_DB=decargo
POSTGRES_PASSWORD=CAMBIAR
DB_API_PASSWORD=CAMBIAR
DB_DOCS_PASSWORD=CAMBIAR
DB_BACKUP_PASSWORD=CAMBIAR

# --- Aplicación ---
# 64 caracteres hexadecimales. Cifra los tokens guardados; sin ella no se pueden volver a mostrar los QR.
APP_KEY=CAMBIAR
# Primer bloque: no hay usuarios todavía. Estos endpoints de prueba se protegen con esta clave y se
# desactivan con DEV_ENDPOINTS=0.
DEV_ENDPOINTS=1
DEV_API_KEY=CAMBIAR

# --- URL pública del servicio documental (base de las URL de los QR) ---
# Pruebas locales: http (NO cumple la Resolución, que exige https). En producción: https://... y sin la línea ALLOW_INSECURE.
# Si publicas en la red local: http://<IP-local>:18081
PUBLIC_DOCS_BASE_URL=http://127.0.0.1:18081
ALLOW_INSECURE_PUBLIC_URL=1

# Web Push: generar una sola vez con `npx web-push generate-vapid-keys --json`.
VAPID_SUBJECT=https://tu-dominio-publico.example
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Puertos del host (no se publica nada hacia Internet) ---
API_PORT=18080
DOCS_PORT=18081
# Dirección en la que `docs` publica su puerto. 127.0.0.1 = solo este equipo. Para que un proxy externo (NPM) llegue
# a `docs` en el futuro habrá que indicar la IP de la red local; no se hace todavía.
DOCS_BIND=127.0.0.1
# Ídem para la API. Para PROBAR desde otros dispositivos de la red local pon aquí y en DOCS_BIND la IP local de este equipo
# (no 0.0.0.0) y la misma IP en PUBLIC_DOCS_BASE_URL. Sin HTTPS: solo para pruebas en una red de confianza.
API_BIND=127.0.0.1
# Interfaz web (navegador). Misma regla: 127.0.0.1 = solo esa máquina; para verla desde otros equipos de la red local, su IP local (no 0.0.0.0).
WEB_BIND=127.0.0.1
WEB_PORT=18082
# 1 = todo PDF lleva el rótulo «DOCUMENTO DE PRUEBA · SIN VALOR». Ponlo a 0 solo en producción.
DECA_TEST_MODE=1

# --- Backup (restic) ---
# Guarda esta contraseña FUERA del servidor: sin ella no se puede abrir ningún backup.
RESTIC_PASSWORD=CAMBIAR

# --- Web pública y ruta de la aplicación ---
# La raíz del dominio es la web pública de DECARGO; la aplicación vive en /<DECARGO_APP_PATH>/. La crea ./deca init (o ./deca up)
# UNA sola vez y no cambia al reiniciar. Cambiarla: ./deca config set-app-path <ruta>|nueva. No sustituye al inicio de sesión.
DECARGO_APP_PATH=
# Botón «Probar DECARGO»: vacío = la demo incluida en /demo/ (datos ficticios, en el navegador); off = ocultarla; o una dirección https.
DECARGO_DEMO_URL=
